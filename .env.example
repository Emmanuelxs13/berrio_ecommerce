# ===================================
# APPLICATION CONFIGURATION
# ===================================
NODE_ENV=development
APP_NAME=Berrio E-commerce
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001

# ===================================
# DATABASE CONFIGURATION
# ===================================
# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/berrio_ecommerce?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=berrio_ecommerce
POSTGRES_PORT=5432

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================================
# AUTHENTICATION
# ===================================
# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===================================
# PAYMENT GATEWAYS
# ===================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox # sandbox or live

# ===================================
# EMAIL SERVICE
# ===================================
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@berrioecommerce.com
SENDGRID_FROM_NAME=Berrio E-commerce

# SMTP (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# ===================================
# FILE STORAGE
# ===================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=berrio-ecommerce-uploads

# Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Local Storage (Development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760 # 10MB

# ===================================
# SECURITY
# ===================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-min

# ===================================
# MONITORING & LOGGING
# ===================================
# Sentry
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# LogRocket
LOGROCKET_APP_ID=your-logrocket-app-id

# ===================================
# ANALYTICS
# ===================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# ===================================
# SHIPPING & LOGISTICS
# ===================================
SHIPPO_API_KEY=your-shippo-api-key
FEDEX_API_KEY=your-fedex-api-key
UPS_API_KEY=your-ups-api-key

# ===================================
# NOTIFICATIONS
# ===================================
# OneSignal (Push Notifications)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# SEARCH
# ===================================
# Algolia (Optional for advanced search)
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_API_KEY=your-algolia-api-key
ALGOLIA_INDEX_NAME=products

# ===================================
# CDN
# ===================================
CDN_URL=https://cdn.berrioecommerce.com

# ===================================
# FEATURE FLAGS
# ===================================
ENABLE_ANALYTICS=true
ENABLE_CACHE=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_GUEST_CHECKOUT=true
ENABLE_REVIEWS=true
ENABLE_WISHLISTS=true

# ===================================
# ADMIN
# ===================================
ADMIN_EMAIL=admin@berrioecommerce.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ===================================
# LOCALIZATION
# ===================================
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,MXN

# ===================================
# DEVELOPMENT
# ===================================
DEBUG=false
LOG_LEVEL=info
PRETTY_PRINT_LOGS=true
